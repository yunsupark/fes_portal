# Copy to .env and fill in values. All variables are required in production.

# MySQL database (your existing FFS database)
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=your-db-name

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=3001
NODE_ENV=production

# Public URL of this deployment (used for CORS allowlist)
APP_URL=https://your-app.up.railway.app

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@nacfe.org
